# BACKENCORDADOS - Configuration Environment

# JWT Authentication
JWT_KEY=changeme_generate_a_secure_key_here_min_32_chars
JWT_ISSUER=Encordados
JWT_AUDIENCE=Encordados

# PostgreSQL Database - Usuarios 
DATABASE_URL_USER=Host=postgres_users;Port=5432;Database=encordados_users;Username=user_usuarios;Password=pass_usuarios123
POSTGRES_USER_USUARIOS=user_usuarios
POSTGRES_PASSWORD_USUARIOS=pass_usuarios123

# PostgreSQL Database - Materials 
DATABASE_URL_MATERIALS=Host=postgres_materials;Port=5432;Database=encordados_materials;Username=user_materials;Password=pass_materials123
POSTGRES_USER_MATERIALS=user_materials
POSTGRES_PASSWORD_MATERIALS=pass_materials123

# MongoDB - Pedidos 
MONGODB_URI_PEDIDOS=mongodb://user_pedidos:pass_pedidos123@mongo_pedidos:27017/pedidos_db?authSource=admin
MONGO_USER_PEDIDOS=user_pedidos
MONGO_PASSWORD_PEDIDOS=pass_pedidos123

# MongoDB - Talleres 
MONGODB_URI_TALLERES=mongodb://user_talleres:pass_talleres123@mongo_talleres:27017/talleres_db?authSource=admin
MONGO_USER_TALLERES=user_talleres
MONGO_PASSWORD_TALLERES=pass_talleres123

# Redis Cache 
REDIS_CACHE_URL=redis://:redis_password123@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_password123

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROMEMAIL=your_email@gmail.com
SMTP_FROMNAME=BackEncordados
SMTP_ADMINEMAIL=admin@backencordados.com

# Cloudinary Configuration
Cloudinary_CloudName=
Cloudinary_ApiKey=
Cloudinary_ApiSecret=

# Server URL
SERVER_URL=https://localhost

# Application Configuration
App__FrontendUrl=http://localhost:3000
App__ServerUrl=https://localhost
App__PasswordResetExpiryMinutes=60
App__EmailOtpExpiryMinutes=15

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# CORS Configuration (for production)
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:8080
Cors__AllowedOrigins__2=http://frontend:80
